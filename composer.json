{
    "name": "clesson-de/silverstripe-developertools",
    "description": "A collection of developer tools for Silverstripe CMS, accessible directly from the CMS admin panel.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "composer", "packages", "versions"],
    "authors": [
        {
            "name": "Kai Feldmaier",
            "email": "kai.feldmaier@clesson.de",
            "homepage": "https://clesson.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^6"
    },
    "autoload": {
        "psr-4": {
            "Clesson\\Silverstripe\\ComposerPackages\\": "src/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}

